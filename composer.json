{
  "name": "liubei/qrcode-share",
  "description": "为帖子与博客生成二维码分享入口。",
  "type": "flarum-extension",
  "keywords": [
    "flarum",
    "qrcode",
    "share",
    "fof-blog"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Liubei"
    }
  ],
  "require": {
    "flarum/core": "^2.0.2"
  },
  "extra": {
    "flarum-extension": {
      "title": "自研 · 二维码分享",
      "icon": {
        "name": "fas fa-qrcode",
        "backgroundColor": "#1f6feb",
        "color": "#ffffff"
      },
      "category": "feature"
    }
  },
  "autoload": {
    "psr-4": {
      "Liubei\\QrCodeShare\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "source": "https://github.com/Lakevy/flarum-ext-xinghai-qrcode-share",
    "issues": "https://github.com/Lakevy/flarum-ext-xinghai-qrcode-share/issues"
  }
}
